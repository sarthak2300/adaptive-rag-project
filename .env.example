# ---- LLM Providers (set the ones you plan to use) ----
LLM_PROVIDER=openai              # openai | groq | gemini
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.1-70b-versatile
GEMINI_MODEL=gemini-1.5-flash

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector Store ----
VECTOR_STORE=faiss               # faiss | qdrant
FAISS_INDEX_PATH=./data/faiss_index
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=adaptive_rag_docs

# ---- Web Search ----
TAVILY_API_KEY=

# ---- MongoDB (chat history) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=adaptive_rag
MONGO_CHAT_COLLECTION=chat_history

# ---- App ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_TOP_K=4
BACKEND_URL=http://localhost:8000
